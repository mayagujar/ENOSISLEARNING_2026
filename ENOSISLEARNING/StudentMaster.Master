<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="StudentMaster.master.cs" Inherits="ENOSISLEARNING.StudentMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>enosis learning</title>
    <link rel="icon" type="image/png" sizes="16x16" href="images/favicon.ico"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
         body {
            overflow-x: hidden;
            background: white;
            font-family: 'Inter', sans-serif;
        }

        #wrapper {
             display: flex;
            flex-direction: column;
            min-height: 95vh;
            overflow-x: hidden;

        }

        /* TOPBAR */
        #topbar {
            height: 64px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 1rem;
            flex-shrink: 0;
        }

        /* SIDEBAR / CONTENT */
        #content-row {
             flex: 1;
            display: flex;
            min-height: 0;
        }

       #sidebar {
            width: 250px;
            min-width: 250px;
            background: #F8FAFC;
            border-radius: 0px 8px 8px 0px; 
            flex-shrink: 0;
            transition: all 0.3s ease;
            overflow-y: auto;
        }



        #sidebar.collapsed {
            margin-left: -250px;
        }
        /* profile section */
.sidebar-profile {
    color: #124170;
}

.profile-pic {
    width: 82px;
    height: 82px;
    border-radius: 50%;
    overflow: hidden;
    margin: 0 auto;
    border: 2px solid rgba(255,255,255,0.8);
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    background: rgba(255,255,255,0.4);
}

.profile-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.candidate-name {
    font-weight: 600;
    font-size: 0.95rem;
}

.candidate-id,
.candidate-course {
    font-size: 0.78rem;
    opacity: 0.8;
}

/* sidebar menu with icons */
.sidebar-menu .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #124170;
    font-size: 0.9rem;
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
}

.sidebar-menu .nav-link:hover {
    background: rgba(230, 238, 252, 0.9);
}
.nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    transition: all 0.3s ease-in-out;
}

.nav-link span {
    font-size: 1.190rem;
    line-height: 1.3;
    padding: 10px;
    transition: transform 0.3s ease-in-out;
}

.menu-icon {
    width: 22px;
    text-align: center;
    font-size: 1.5rem;
    transition: transform 0.3s ease-in-out;
}
.nav-link:hover .menu-icon {
    transform: translateX(5px);
}

.nav-link:hover span {
    transform: translateX(5px);
}

.nav-link:hover {
    transform: translateX(3px);
}

.sidebar-menu .nav-link i {
    color: #124170;
}


       #main {
            flex: 1;
            padding: 1rem;
            min-width: 0; /* prevent horizontal overflow */
            overflow-x: hidden;
        }

        /* FOOTER */
        #footer {
           height: 30px;
            padding: 0 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 0.85rem;
            text-align: center;
            background-color: #f0f0f0;
        }
        #footer a
        {
            text-align:center;
        }

        /* LOGO / BRAND */
        .navbar-brand {
            display: flex;
            flex-direction: column;
            justify-content: center;
            line-height: 1.15;
        }

        .navbar-brand span {
            font-size: 24px;
            line-height: 1;
        }

        .brand-slogan {
            font-size: 0.7rem;
            letter-spacing: 0.3px;
            display: block;
            color: #124170;
            opacity: .9;
            line-height: 2;
        }
        /* HAMBURGER BUTTON */
.burger-btn {
    width: 44px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid rgba(18, 65, 112, .12);
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px; /* more gap */
    padding: 6px 6px;
    box-shadow: 0 6px 14px rgba(0, 0, 0, .12);
    cursor: pointer;
    transition: all .25s ease;
}

.burger-line {
    width: 22px;           /* fixed width, not 100% */
    height: 3px;           /* bigger, more visible */
    border-radius: 5px;
    background: #124170;
    transition: all .25s ease;
}

.burger-btn:hover {
    background: #f0f6ff;
    transform: translateY(-1px);
}


        .burger-btn:active {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(0, 0, 0, .18);
        }

        .burger-btn:active .burger-line:nth-child(2) {
            width: 60%;
        }

        /* SIDEBAR LINKS */
        #sidebar .nav-link {
            color: #124170;
            font-size: 0.9rem;
            border-radius: 4px;
            padding: .35rem .75rem;
        }

        #sidebar .nav-link:hover {
            background: #e6eefc;
        }
        .modal-dialog {
            margin: auto !important;
        }
.glass-card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 16px;

    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);

    color: #fff;
}

.modal-backdrop.show {
    backdrop-filter: blur(4px);
}
/* Glass Popup */
.glass-logout {
    backdrop-filter: blur(12px);
    border-radius: 16px;
    animation: zoomIn 0.3s ease;
}

/* Confirm Button */
        .logout-ok-btn {
            background: linear-gradient(135deg, #ff4d4d, #d60000);
            color: white !important;
            padding: 8px 20px;
            border-radius: 8px;
            font-weight: bold;
            border: none;
            box-shadow: 0 0 12px rgba(255, 0, 0, 0.5);
            transition: 0.2s;
            margin-right: 10px;
        }
.logout-ok-btn:hover {
    transform: scale(1.07);
    box-shadow: 0 0 18px rgba(255, 0, 0, 0.7);
}

/* Cancel Button */
.logout-cancel-btn {
    background: #eee;
    color: #333 !important;
    padding: 8px 20px;
    border-radius: 8px;
    border: none;
    font-weight: bold;
    transition: 0.2s;
}
.logout-cancel-btn:hover {
    transform: scale(1.07);
}

/* Animation */
@keyframes zoomIn {
    0% { transform: scale(0.65); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}
.profile-glass {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(15px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.5);
}

.profile-avatar-glow {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.4),
                0 0 35px rgba(0, 185, 255, 0.45);
}

.info-box {
    background: rgba(255, 255, 255, 0.12);
    padding: 15px 18px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
}

.info-label {
    font-size: 12px;
    color: #D1D5DB;
    display: block;
}

.info-value {
    font-size: 18px;
    font-weight: 600;
    color: #F8FAFC;
}
.resume-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    flex-direction: column;
}

.resume-header {
    height: 55px;
    padding: 0 20px;
    color: #fff;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,0.08);
}

.resume-header button {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
}

.resume-frame {
    flex: 1;
    width: 100%;
    border: none;
    background: #111;
}
.resume-link.disabled {
    color: #aaa !important;
    cursor: not-allowed;
    text-decoration: none;
}

.resume-link.disabled:hover {
    text-decoration: none;
}
    </style>
