<!-- BOOTSTRAP JS + TOGGLE SCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<%-- Sidebar Toggle --%>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("btnToggle");
        var sidebar = document.getElementById("sidebar");
        btn.addEventListener("click", function () {
            sidebar.classList.toggle("collapsed");
        });
    });

    function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");

        if (sidebar.style.left === "0px") {
            sidebar.style.left = "-250px";
        }
        else {
            sidebar.style.left = "0px";
        }
    }
</script>
<%-- Logout --%>
<script>
    function logoutConfirm() {
        Swal.fire({
            title: "Logout?",
            text: "Really Want To Logout?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, Logout",
            cancelButtonText: "Cancel",

            background: "rgba(255, 255, 255, 0.15)",
           

            customClass: {
                popup: 'glass-logout',
                confirmButton: 'logout-ok-btn',
                cancelButton: 'logout-cancel-btn'
            },
            buttonsStyling: false,

            // Important settings
            allowOutsideClick: true,
            allowEscapeKey: true
        }).then((result) => {

            // YES → Logout
            if (result.isConfirmed) {
                window.location.href = "Logout.aspx";
            }

            // CANCEL → Force close everything
            if (result.dismiss === Swal.DismissReason.cancel) {

                // Popup close
                Swal.close();

                // Backdrop clean
                $(".swal2-container").remove();
                $(".swal2-backdrop").remove();   // Extra cleanup
            }
        });
    }
</script>
<%-- //Preview Resume File// --%>
<script>
    function showResumePreview(el) {
        var resumeUrl = el.dataset.resume;

        if (!resumeUrl || resumeUrl.trim() === "") {
            var profileModal = new bootstrap.Modal(document.getElementById('myProfileModal'), {
                keyboard: false
            });
            profileModal.show();
            return false; 
        }
        document.getElementById("resumeFrame").src = resumeUrl;
        document.getElementById("resumeOverlay").style.display = "flex";
        return false; // prevent postback
    }

    function closeResumePreview() {
        document.getElementById("resumeOverlay").style.display = "none";
        document.getElementById("resumeFrame").src = "";
    }
</script>
<%-- Profile picture upload --%>
<script>
    $("#uploadBtn").click(function () {

        var fileInput = document.getElementById("profilePicFile");

        if (!fileInput || fileInput.files.length === 0) {
            Swal.fire("Select image first");
            return;
        }

        var file = fileInput.files[0];

        if (file.size > 2 * 1024 * 1024) {
            Swal.fire("Max 2MB allowed");
            return;
        }

        var formData = new FormData();
        formData.append("file", file);

        $.ajax({
            url: "../UploadProfilePic.ashx",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (path) {

                if (path) {
                    $("#Profileimg").attr("src", path + "?t=" + new Date().getTime());
                    $("#ProfilePic").attr("src", path + "?t=" + new Date().getTime());
                }
                fileInput.value = "";
                $('#profilepicModal').modal('hide');
                Swal.fire("Uploaded!", "Profile picture updated", "success");
            },
            error: function () {
                Swal.fire("Upload failed");
            }
        });
    });
</script>
<%-- Update Resume --%>
<script>
    $("#resumeFile").on("change", function () {

        var file = this.files[0];
        if (!file) return;

        var ext = file.name.split('.').pop().toLowerCase();
        if (ext !== "pdf" && ext !== "doc" && ext !== "docx") {
            Swal.fire("Invalid File", "Upload PDF / DOC / DOCX only", "warning");
            this.value = "";
            return;
        }

        var formData = new FormData();
        formData.append("resume", file);

        $.ajax({
            url: "../UploadCandidateResume.ashx",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (fileName) {

                if (fileName) {
                    $("#<%= Resumelbl.ClientID %>").text(fileName);
                    $("#<%= lnkResume.ClientID %>").text(fileName);
                    Swal.fire("Updated", "Resume updated successfully", "success");
                }

                $("#resumeFile").val("");
            },
            error: function () {
                Swal.fire("Error", "Resume upload failed", "error");
            }
        });
    });
</script>

    </form>
</body>
</html>
